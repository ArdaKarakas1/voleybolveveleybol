---
/**
 * "Google ile devam et" düğmesi + ayraç.
 * GOOGLE_CLIENT_ID derleme ortamında tanımlı değilse hiç render edilmez —
 * yapılandırılmamış bir sağlayıcının düğmesi kullanıcıya gösterilmez.
 * kimlik.js, ?donus parametresini bağlantıya sayfa yüklenince ekler.
 */
const acik = !!process.env.GOOGLE_CLIENT_ID;
---
{acik && (
  <>
    <div class="form-ayrac"><span>veya</span></div>
    <a class="btn btn-google" href="/api/google-basla" data-google-giris>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.39 3.62v3h3.87c2.26-2.09 3.57-5.16 3.57-8.81Z"/>
        <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.93-2.91l-3.87-3.01c-1.07.72-2.45 1.15-4.06 1.15-3.13 0-5.78-2.11-6.72-4.96H1.29v3.1A12 12 0 0 0 12 24Z"/>
        <path fill="#FBBC05" d="M5.28 14.27a7.2 7.2 0 0 1 0-4.54v-3.1H1.29a12 12 0 0 0 0 10.74l3.99-3.1Z"/>
        <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.61 4.58 1.79l3.44-3.43C17.95 1.19 15.23 0 12 0A12 12 0 0 0 1.29 6.63l3.99 3.1C6.22 6.88 8.87 4.77 12 4.77Z"/>
      </svg>
      Google ile devam et
    </a>
  </>
)}
