---
/**
 * Alt bilgi. İlk iki sütun her sayfada aynı; üçüncü sütun sayfaya göre
 * değişiyor (ana sayfada "İçerik", kurallarda "Popüler kurallar").
 * Onu `links` ile veriyoruz.
 */
const {
  links = {
    title: 'İçerik',
    items: [
      { href: '/#anlatim', label: 'Voleybol anlatımları' },
      { href: '/#analiz', label: 'Maç analizi & haber' },
      { href: '/#eglence', label: 'Eğlence & shorts' },
      { href: 'https://www.youtube.com/@voleybolveveleybol/videos', label: 'YouTube arşivi', external: true }
    ]
  }
} = Astro.props;
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href="/">
          <img src="/assets/img/logo-192.png" alt="" width="38" height="38" />
          <span class="brand-name">Voleybol<b>ve Veleybol</b></span>
        </a>
        <p>Türkçe voleybol içerikleri: teknik anlatımlar, kural açıklamaları ve maç analizleri.</p>
        <div class="social-row">
          <a href="https://www.youtube.com/@voleybolveveleybol" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.4a2.9 2.9 0 0 0-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.4a2.9 2.9 0 0 0 2-2C23 15.8 23 12 23 12ZM9.8 15.5v-7l6.1 3.5-6.1 3.5Z"/></svg>
          </a>
          <a href="https://www.instagram.com/voleybolveveleybol" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.tiktok.com/@voleybolveveleybol" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.4 1.9 4 4.5 4.3v3c-1.7.1-3.2-.4-4.6-1.3v5.6c0 3.6-2.7 6.4-6.2 6.4S4 18.2 4 14.6c0-3.3 2.4-6 5.7-6.3v3.1a3.2 3.2 0 1 0 3 3.2V3h3.8Z"/></svg>
          </a>
          <a href="mailto:voleybolveveleybol@gmail.com" aria-label="E-posta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="m3 7 8.1 5.4a2 2 0 0 0 2.2 0L21 7"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/">Ana sayfa</a></li>
          <li><a href="/kurallar/">Kurallar sözlüğü</a></li>
          <li><a href="/testler/">Kural testleri</a></li>
          <li><a href="/#iletisim">İş birliği</a></li>
        </ul>
      </div>
      <div>
        <h4>{links.title}</h4>
        <ul>
          {links.items.map((l) => (
            <li>
              {l.external
                ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                : <a href={l.href}>{l.label}</a>}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span data-year>2026</span> Voleybol ve Veleybol</span>
      <span>Kural bilgileri FIVB 2025–2028 resmî oyun kurallarına dayanır.</span>
    </div>
  </div>
</footer>
