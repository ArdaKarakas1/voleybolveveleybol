---
import Base from '../layouts/Base.astro';
---
<Base
  title="Kayıt ol | Voleybol ve Veleybol"
  description="Ücretsiz hesap aç; voleybol kural testlerini çöz, skorlarını kaydet, sıralamada yerini al."
  path="/kayit/"
  robots="noindex, nofollow"
  scripts={['/assets/js/kimlik.js']}
>
<main id="main" class="section" style="min-height:70vh;display:grid;place-items:center">
  <div class="shell" style="max-width:440px">
    <div class="center" style="margin-bottom:28px">
      <span class="eyebrow">Aramıza katıl</span>
      <h1 style="font-size:var(--step-3);margin-top:14px">Hesap aç</h1>
      <p class="text-dim" style="margin-top:10px">Testlerini kaydet, skorlarını takip et.</p>
    </div>
    <div class="panel">
      <form class="form-dizi" data-kimlik-form="kayit" novalidate>
        <div class="form-hata" id="formHata" role="alert"></div>
        <div class="form-alan">
          <label for="kullanici_adi">Kullanıcı adı</label>
          <input id="kullanici_adi" name="kullanici_adi" type="text" autocomplete="username"
                 required minlength="3" maxlength="24" pattern="[a-zA-Z0-9_]+"
                 spellcheck="false" autofocus />
          <span class="ipucu">3–24 karakter; harf, rakam ve alt çizgi. Sıralamada bu ad görünür.</span>
        </div>
        <div class="form-alan">
          <label for="eposta">E-posta</label>
          <input id="eposta" name="eposta" type="email" autocomplete="email" required />
          <span class="ipucu">Kimseyle paylaşılmaz; yalnızca giriş ve parola sıfırlama için.</span>
        </div>
        <div class="form-alan">
          <label for="parola">Parola</label>
          <input id="parola" name="parola" type="password" autocomplete="new-password" required minlength="10" />
          <span class="ipucu">En az 10 karakter. Uzun bir cümle, karmaşık kısaltmadan iyidir.</span>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%">Hesap aç</button>
        <p class="form-alt">Zaten üye misin? <a href="/giris/">Giriş yap</a></p>
      </form>
    </div>
  </div>
</main>
</Base>
