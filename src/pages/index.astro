---
import Base from '../layouts/Base.astro';

const jsonLd = `
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://voleybolveveleybol.com/#website",
      "url": "https://voleybolveveleybol.com/",
      "name": "Voleybol ve Veleybol",
      "inLanguage": "tr-TR",
      "description": "Türkçe voleybol kuralları, teknik anlatımlar ve maç analizleri.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://voleybolveveleybol.com/kurallar/?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://voleybolveveleybol.com/#org",
      "name": "Voleybol ve Veleybol",
      "url": "https://voleybolveveleybol.com/",
      "logo": "https://voleybolveveleybol.com/assets/img/logo-512.png",
      "sameAs": [
        "https://www.youtube.com/@voleybolveveleybol",
        "https://www.instagram.com/voleybolveveleybol",
        "https://www.tiktok.com/@voleybolveveleybol"
      ]
    }
  ]
}
`;
---
<Base
  title="Voleybol ve Veleybol — Voleybol kuralları, teknik anlatımlar ve maç analizleri"
  description="Voleybolu birlikte öğreniyoruz: temel teknikler, sık yapılan hatalar, aranabilir voleybol kuralları sözlüğü, kural testi ve Sultanlar Ligi maç analizleri. Türkçe voleybol içerik kanalı."
  path="/"
  ogTitle="Voleybol ve Veleybol — kurallar, teknik, maç analizi"
  ogDescription="Aranabilir voleybol kuralları sözlüğü, kural testi, teknik anlatımlar ve Sultanlar Ligi analizleri."
  active="home"
  scripts={['/assets/js/home.js']}
  preconnect={['https://i.ytimg.com']}
  preload="/assets/img/logo-512.webp"
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

<main id="main">

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow"><span class="dot"></span>Türkçe voleybol kanalı</span>
        <h1>Voleybol <span class="ve">ve</span><br><span class="vel">Veleybol</span></h1>
        <p class="hero-lede">
          Doğru teknik, sık yapılan hatalar ve temel kurallar — sahada işine yarayacak şekilde,
          Türkçe anlatımla. Üstüne Sultanlar Ligi analizleri ve bolca voleybol keyfi.
        </p>
        <div class="hero-cta">
          <a class="btn btn-yt" href="https://www.youtube.com/@voleybolveveleybol?sub_confirmation=1" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.8-.5-5.6a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.4a2.9 2.9 0 0 0-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.4a2.9 2.9 0 0 0 2-2C23 15.8 23 12 23 12ZM9.8 15.5v-7l6.1 3.5-6.1 3.5Z"/></svg>
            YouTube'da abone ol
          </a>
          <a class="btn btn-ghost" href="/kurallar/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v16H6.5A2.5 2.5 0 0 0 4 21.5Z"/><path d="M4 19.5V5.5"/></svg>
            Kuralları aç
          </a>
          <a class="btn btn-accent" href="/testler/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 9a3 3 0 1 1 4.2 2.7c-.8.4-1.3 1.2-1.3 2.1v.4"/><path d="M12 17.6h.01"/><circle cx="12" cy="12" r="9.2"/></svg>
            Kural testini çöz
          </a>
        </div>
      </div>
      <figure class="hero-figure">
        <img src="/assets/img/logo-512.webp" alt="Voleybol ve Veleybol kanal logosu" width="300" height="300" fetchpriority="high">
      </figure>
    </div>
  </section>

  <!-- ================= TOPLULUK ================= -->
  <section class="section" id="topluluk">
    <div class="shell">
      <div class="counter-band reveal">
        <div class="counter-head">
          <div>
            <h2>Bakın bu kadar kişiyiz</h2>
            <p style="color:#B9C4DE;font-size:14.5px;margin-top:8px">Üç platformdaki topluluk, canlı olarak sayılıyor.</p>
          </div>
          <span class="live"><span class="dot"></span>Canlı</span>
        </div>
        <div class="counter-grid">
          <a class="counter is-total" href="#" onclick="return false;" aria-label="Toplam topluluk">
            <div class="num" data-stat="total" data-fallback="5324">—</div>
            <div class="lbl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20v-1.8a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"/><circle cx="9.5" cy="7" r="3.5"/><path d="M22 20v-1.8a4 4 0 0 0-3-3.9"/><path d="M16 3.3a4 4 0 0 1 0 7.4"/></svg>
              Toplam topluluk
            </div>
          </a>
          <a class="counter" href="https://www.youtube.com/@voleybolveveleybol?sub_confirmation=1" target="_blank" rel="noopener">
            <div class="num" data-stat="yt" data-fallback="2030">—</div>
            <div class="lbl">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.4a2.9 2.9 0 0 0-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.4a2.9 2.9 0 0 0 2-2C23 15.8 23 12 23 12ZM9.8 15.5v-7l6.1 3.5-6.1 3.5Z"/></svg>
              YouTube abonesi
            </div>
          </a>
          <a class="counter" href="https://www.instagram.com/voleybolveveleybol" target="_blank" rel="noopener">
            <div class="num" data-stat="ig" data-fallback="2518">—</div>
            <div class="lbl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
              Instagram takipçisi
            </div>
          </a>
          <a class="counter" href="https://www.tiktok.com/@voleybolveveleybol" target="_blank" rel="noopener">
            <div class="num" data-stat="tt" data-fallback="776">—</div>
            <div class="lbl">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.4 1.9 4 4.5 4.3v3c-1.7.1-3.2-.4-4.6-1.3v5.6c0 3.6-2.7 6.4-6.2 6.4S4 18.2 4 14.6c0-3.3 2.4-6 5.7-6.3v3.1a3.2 3.2 0 1 0 3 3.2V3h3.8Z"/></svg>
              TikTok takipçisi
            </div>
          </a>
        </div>
        <p class="counter-foot" data-stat-note>Sayılar yükleniyor…</p>
      </div>
    </div>
  </section>

  <!-- ================= SON İÇERİK ================= -->
  <section class="section reveal">
    <div class="shell">
      <div class="section-head">
        <div>
          <h2>Son içerik</h2>
          <p>Kanala yüklenen en yeni videolar — liste kendiliğinden güncellenir</p>
        </div>
        <a class="link-more" href="https://www.youtube.com/@voleybolveveleybol/videos" target="_blank" rel="noopener">Tüm videolar →</a>
      </div>
      <div class="feature-grid" id="featured">
        <div class="skeleton"></div>
        <div class="feature-side"><div class="skeleton"></div><div class="skeleton"></div></div>
      </div>
    </div>
  </section>

  <!-- ================= KATEGORİLİ RAFLAR (JS ile dolar) ================= -->
  <div id="rails"></div>

  <!-- ================= KURALLAR + QUIZ ================= -->
  <section class="section reveal" id="ogren">
    <div class="shell">
      <div class="section-head">
        <div>
          <h2>Sadece izleme, kullan</h2>
          <p>Sahada aklına takılanı saniyeler içinde bulabileceğin iki araç</p>
        </div>
      </div>
      <div class="split">
        <article class="promo">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v16H6.5A2.5 2.5 0 0 0 4 21.5Z"/><path d="M8 7.5h7M8 11h7"/></svg>
          </span>
          <h3>Voleybol Kuralları Sözlüğü</h3>
          <p>
            Kaç sette maç biter, libero neden hücum edemez, "dört vuruş" ne demek, rotasyon hatası nasıl olur —
            hepsi tek sayfada, aranabilir ve kategorilere ayrılmış hâlde. Sahada telefondan bakabilirsin.
          </p>
          <a class="btn btn-primary" href="/kurallar/">Kuralları aç</a>
        </article>
        <article class="promo">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 9a3 3 0 1 1 4.2 2.7c-.8.4-1.3 1.2-1.3 2.1v.4"/><path d="M12 17.6h.01"/><circle cx="12" cy="12" r="9.2"/></svg>
          </span>
          <h3>Kural Testi</h3>
          <p>
            Kuralları gerçekten biliyor musun? 14 soruluk hızlı test — her sorunun sonunda doğru cevabın
            <em>neden</em> doğru olduğunu da açıklıyorum. Sonucunu arkadaşlarınla paylaş, kim daha iyi görelim.
          </p>
          <a class="btn btn-accent" href="/testler/">Teste başla</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= HAKKINDA / İŞ BİRLİĞİ ================= -->
  <section class="section reveal" id="iletisim">
    <div class="shell">
      <div class="section-head">
        <div>
          <h2>Kanal hakkında &amp; iş birliği</h2>
          <p>Kim olduğum, ne ürettiğim ve markalarla nasıl çalıştığım</p>
        </div>
      </div>
      <div class="panel">
        <div class="split" style="gap:28px">
          <div class="stack" style="--gap:14px">
            <h3 style="font-size:var(--step-2)">Neden bu kanal var?</h3>
            <p class="text-dim">
              Türkiye'de voleybol izleyicisi çok, ama sporu <strong>doğru</strong> anlatan Türkçe kaynak az.
              Amacım basit: yeni başlayan biri manşeti düzgün alsın, maç izleyen biri hakemin neden düdük
              çaldığını anlasın. Bir yandan da işin eğlenceli tarafını kaçırmayalım — kanalın adındaki
              "Veleybol" tam olarak o.
            </p>
            <p class="text-dim">
              İçerik: teknik anlatımlar, kural açıklamaları, Sultanlar Ligi ve milli takım analizleri,
              sahadan kısa videolar.
            </p>
          </div>
          <div class="stack" style="--gap:14px">
            <h3 style="font-size:var(--step-2)">Markalar için</h3>
            <p class="text-dim">
              Voleybol ekipmanı, spor giyim, saha/kulüp ve spor beslenmesi markalarıyla iş birliğine açığım.
              Ürün yerleştirme, tanıtım videosu, uzun vadeli sponsorluk ve etkinlik içeriği konuşabiliriz.
              Yalnızca gerçekten kullandığım ve önerebileceğim ürünleri tanıtıyorum.
            </p>
            <div class="social-row" style="margin-top:4px">
              <a href="mailto:voleybolveveleybol@gmail.com" aria-label="E-posta gönder" title="E-posta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="m3 7 8.1 5.4a2 2 0 0 0 2.2 0L21 7"/></svg>
              </a>
              <a href="https://www.instagram.com/voleybolveveleybol" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
              </a>
            </div>
            <a class="btn btn-primary" style="align-self:flex-start" href="mailto:voleybolveveleybol@gmail.com?subject=%C4%B0%C5%9F%20birli%C4%9Fi%20teklifi%20%E2%80%94%20Voleybol%20ve%20Veleybol">İş birliği için yaz</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>
</Base>
