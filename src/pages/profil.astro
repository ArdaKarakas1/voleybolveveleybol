---
import Base from '../layouts/Base.astro';
---
<Base
  title="Profilim | Voleybol ve Veleybol"
  path="/profil/"
  robots="noindex, nofollow"
  active=""
  scripts={['/assets/js/profil.js']}
>
<main id="main" class="section">
  <div class="shell" style="max-width:640px">
    <div class="section-head" style="margin-bottom:24px">
      <h2>Profilim</h2>
    </div>

    <p class="text-dim" id="profilYukleniyor">Profil yükleniyor…</p>

    <div class="panel form-dizi" id="profilKart" hidden>
      <div class="form-alan">
        <label>Kullanıcı adı</label>
        <p style="font-size:var(--step-1);font-weight:700" id="pKullanici">—</p>
      </div>
      <div class="form-alan">
        <label>E-posta</label>
        <p id="pEposta">—</p>
        <span class="ipucu" id="pDogrulama">—</span>
      </div>
      <div class="form-alan">
        <label>Üyelik tarihi</label>
        <p id="pTarih">—</p>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
        <a class="btn btn-primary" href="/testler/">Kural testini çöz</a>
        <button class="btn btn-ghost" type="button" id="cikisBtn">Çıkış yap</button>
      </div>
      <div class="form-alan" style="margin-top:8px">
        <label>Skor geçmişi</label>
        <div id="skorGecmisi"><p class="text-dim">Yükleniyor…</p></div>
      </div>

      <div class="tehlike-alani">
        <h3>Hesabı sil</h3>
        <p class="text-dim">Hesabın, test geçmişin ve sıralamadaki yerin <strong>kalıcı olarak</strong> silinir. Geri dönüşü yoktur.</p>
        <button class="btn btn-ghost" type="button" id="silBaslat">Hesabımı silmek istiyorum</button>
        <form class="form-dizi" id="silForm" hidden>
          <div class="form-hata" id="silHata" role="alert"></div>
          <div class="form-alan">
            <label for="silOnay">Onaylamak için kullanıcı adını yaz</label>
            <input id="silOnay" name="onay" type="text" autocomplete="off" spellcheck="false" />
          </div>
          <button class="btn btn-tehlike" type="submit">Hesabı kalıcı olarak sil</button>
        </form>
      </div>
    </div>
  </div>
</main>
</Base>
