---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Voleybol Kural Testi — 14 soru, açıklamalı | Voleybol ve Veleybol"
  description="Voleybol kurallarını gerçekten biliyor musun? 14 soruluk hızlı test. Her sorunun sonunda doğru cevabın neden doğru olduğunu açıklıyoruz. Sonucunu paylaş."
  path="/quiz/"
  ogTitle="Voleybol Kural Testi — kaç yapabilirsin?"
  ogDescription="14 soruluk açıklamalı voleybol kural testi. Hakem gibi mi biliyorsun, yoksa ısınma turunda mısın?"
  active="quiz"
  scripts={['/assets/js/quiz.js']}
>
<main id="main">
  <section class="section">
    <div class="shell">
      <div class="center" style="max-width:640px;margin-inline:auto;margin-bottom:34px">
        <span class="eyebrow">14 soru · ~4 dakika</span>
        <h1 style="font-size:var(--step-4);margin-top:16px">Voleybol Kural Testi</h1>
        <p class="text-dim" style="margin-top:14px;font-size:var(--step-1)">
          Her cevaptan sonra doğrunun <em>neden</em> doğru olduğunu da açıklıyorum.
          Sorular her denemede karışık gelir.
        </p>
      </div>
      <div class="panel quiz-card" id="quizHost">
        <div class="empty">Test yükleniyor…</div>
      </div>
    </div>
  </section>
</main>
</Base>
